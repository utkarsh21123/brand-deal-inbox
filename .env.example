# Copy to .env and fill in. Leave LLM_PROVIDER empty to run rules-only (no network, no key).
#
# LLM_PROVIDER: groq | gemini | openrouter | ollama
LLM_PROVIDER=
LLM_API_KEY=
# Optional. Each provider has a default; model names change, so override if it 404s.
LLM_MODEL=
# Optional. Only needed for a self-hosted or non-default endpoint.
LLM_BASE_URL=
